    {
      "name": "fftw_upols_vs_arm_freq_powersave_16_banks",
      "executable": "nice -20 ./internal_stream_perf -w 0 -be fftw-upols -b 16",
      "governor": "powersave",
      "fixed_config": {
        "v3d_freq_min": 500,
        "core_freq_min": 500
      },
      "sweep": {
        "var": "arm_freq_min",
        "values": [2400, 2300, 2200, 2100, 1900, 1800, 1700, 1600, 1500]
      },
      "total_iterations": 9,
      "tag_fields": ["arm_freq_min", "core_freq_min", "v3d_freq_min"],
      "max_runtime_sec": 600
    },
