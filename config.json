{
  "host": {
    "wattsup_com_port": "COM3",
    "sample_interval_sec": 1.0,
    "log_root": "C:/Users/erippey3/Documents/benchmark_orchestrator/bench_logs"
  },
  "dut": {
    "hostname": "ritvik-RPI5",
    "username": "ritvik",
    "root_access": true,
    "build_dir": "/home/ritvik/edgedevice-fft/build",
    "config_txt": "/boot/firmware/config.txt",
    "comm_file": "/tmp/ready"
  },
  "stability": {
    "window_size": 15,
    "required_consecutive_windows": 3,
    "max_range_watts": 0.201,
    "max_step_delta_watts": 0.101
  },
  "retry": {
    "max_attempts": 8,
    "cooldown_sec": 120,
    "ssh_wait_timeout_sec": 300
  },
  "tests": [
    {
      "name": "FFTW_arm_freq_powersave",
      "executable": "./fftw_ola_bench",
      "governor": "powersave",
      "fixed_config": {
        "v3d_freq_min": 500,
        "core_freq_min": 500
      },
      "sweep": {
        "var": "arm_freq_min",
        "values": [2000]
      },
      "total_iterations": 9,
      "tag_fields": ["arm_freq_min", "core_freq_min", "v3d_freq_min"],
      "max_runtime_sec": 600
    },
    {
      "name": "PoCL_arm_freq_powersave",
      "executable": "./pocl_ola_bench",
      "governor": "powersave",
      "fixed_config": {
        "v3d_freq_min": 500,
        "core_freq_min": 500
      },
      "sweep": {
        "var": "arm_freq_min",
        "values": [2000]
      },
      "total_iterations": 9,
      "tag_fields": ["arm_freq_min", "core_freq_min", "v3d_freq_min"],
      "max_runtime_sec": 600
    },
    {
      "name": "FFTW_arm_freq_performance",
      "executable": "./fftw_ola_bench",
      "governor": "performance",
      "fixed_config": {
      },
      "sweep": {
        "var": "arm_freq",
        "values": [2000, 1600]
      },
      "total_iterations": 6,
      "tag_fields": ["arm_freq"],
      "max_runtime_sec": 600
    },
    {
      "name": "PoCL_arm_freq_performance",
      "executable": "./pocl_ola_bench",
      "governor": "performance",
      "fixed_config": {
      },
      "sweep": {
        "var": "arm_freq",
        "values": [2400, 2300, 2200, 2100, 2000, 1900, 1800, 1700, 1600]
      },
      "total_iterations": 9,
      "tag_fields": ["arm_freq"],
      "max_runtime_sec": 600
    },
    {
      "name": "clvk_arm_freq_powersave",
      "executable": "./clvk_ola_bench",
      "governor": "powersave",
      "fixed_config": {
        "arm_freq_min": 1200,
        "core_freq_min": 500
      },
      "sweep": {
        "var": "v3d_freq_min",
        "values": [500, 550, 600, 650, 700, 750, 800, 850, 900, 960]
      },
      "total_iterations": 3,
      "tag_fields": ["arm_freq_min", "core_freq_min", "v3d_freq_min"],
      "max_runtime_sec": 600
    },
    {
      "name": "FFTW_arm_freq_performance",
      "executable": "./fftw_ola_bench",
      "governor": "performance",
      "fixed_config": {
      },
      "sweep": {
        "var": "arm_freq",
        "values": [2400, 2300, 2200, 2100, 2000, 1900, 1800, 1700, 1600]
      },
      "total_iterations": 3,
      "tag_fields": ["arm_freq"],
      "max_runtime_sec": 600
    }
  ]
}